<Window x:Class="WashinPC.UI.Dialogs.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WashinPC.Localization"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="ConfirmYesButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#FFD9DEE7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.PrimaryHover}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.PrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.PrimaryPressed}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.PrimaryPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- OUTER CARD -->
    <Border
        Width="420"
        CornerRadius="12"
        Background="#F7F8FA"
        BorderBrush="#1A000000"
        BorderThickness="1"
        SnapsToDevicePixels="True">

        <!-- IMPORTANT: clips accent to rounded corners -->
        <Grid ClipToBounds="True">

            <!-- ACCENT STRIP -->
            <Border
                Width="6"
                Background="{Binding AccentBrush}"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                CornerRadius="12,0,0,12"/>

            <!-- CONTENT -->
            <Grid Margin="18">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TITLE -->
                <TextBlock
                    Text="{Binding Title}"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,0,0,10"/>

                <!-- MESSAGE -->
                <TextBlock Grid.Row="1"
                           Text="{Binding Message}"
                           TextWrapping="Wrap"
                           Opacity="0.85"
                           Margin="0,0,0,20"/>

                <!-- BUTTONS -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <!-- YES / NO -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ShowYesNo,
                                    Converter={StaticResource BooleanToVisibilityConverter}}">

                        <Button Width="90"
                                Margin="0,0,8,0"
                                Style="{StaticResource PrimaryButton}"
                                Content="{Binding Source={x:Static loc:Loc.BtnNo}, Path=Value}"
                                Command="{Binding NoCommand}"/>

                        <Button Width="90"
                                Style="{StaticResource ConfirmYesButton}"
                                Content="{Binding Source={x:Static loc:Loc.BtnYes}, Path=Value}"
                                Command="{Binding YesCommand}"/>
                    </StackPanel>

                    <!-- OK -->
                    <Button Width="90"
                            Style="{StaticResource PrimaryButton}"
                            Background="{Binding AccentBrush}"
                            Content="{Binding Source={x:Static loc:Loc.BtnOk}, Path=Value}"
                            Command="{Binding OkCommand}"
                            Visibility="{Binding ShowOk,
                                Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

            </Grid>
        </Grid>
    </Border>
</Window>
