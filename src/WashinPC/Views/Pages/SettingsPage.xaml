<UserControl
    x:Class="WashinPC.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:WashinPC.Localization">

    <StackPanel Margin="24" Width="320">

        <TextBlock
            Text="{Binding Source={x:Static loc:Loc.SettingsLanguage}, Path=Value}"
            Margin="0,0,0,8"
            FontWeight="SemiBold"/>

        <ComboBox
            SelectedIndex="{Binding LanguageIndex}"
            Margin="0,0,0,16">
            <ComboBoxItem Content="{Binding Source={x:Static loc:Loc.SettingsLangRussian}, Path=Value}"/>
            <ComboBoxItem Content="{Binding Source={x:Static loc:Loc.SettingsLangEnglish}, Path=Value}"/>
        </ComboBox>

        <TextBlock
            Text="{Binding Source={x:Static loc:Loc.SettingsInstantApply}, Path=Value}"
            Foreground="Gray"/>

        <Border Height="1" Background="#E4E6EA" Margin="0,16,0,12"/>

        <CheckBox
            Content="{Binding Source={x:Static loc:Loc.SettingsRegistryExpertMode}, Path=Value}"
            IsChecked="{Binding RegistryExpertMode, Mode=TwoWay}"
            Margin="0,0,0,6"/>

        <TextBlock
            Text="{Binding Source={x:Static loc:Loc.SettingsRegistryExpertHint}, Path=Value}"
            Foreground="Gray"
            TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
