<UserControl x:Class="WashinPC.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WashinPC.Localization">

    <Grid Margin="24">
        <StackPanel Width="576" HorizontalAlignment="Left">

            <Border Style="{StaticResource ContentCard}" Margin="0,0,0,24" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Path Data="{StaticResource Icon.Globe}" Style="{StaticResource HeaderIconPath}"/>
                        <TextBlock Text="{Binding Source={x:Static loc:Loc.SettingsLanguage}, Path=Value}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <ComboBox Style="{StaticResource FlatComboBox}"
                              Width="256"
                              ItemsSource="{Binding LanguageOptions}"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"/>

                    <TextBlock Margin="0,10,0,0"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               FontSize="12"
                               Text="{Binding Source={x:Static loc:Loc.SettingsInstantApply}, Path=Value}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ContentCard}" Margin="0,0,0,24" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Path Data="{StaticResource Icon.Sun}" Style="{StaticResource HeaderIconPath}"/>
                        <TextBlock Text="{Binding Source={x:Static loc:Loc.SettingsAppearance}, Path=Value}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding SetThemeAutoCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Monitor}" Style="{StaticResource ButtonIconPath}"/>
                                <TextBlock Text="{Binding Source={x:Static loc:Loc.SettingsThemeAuto}, Path=Value}"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ThemeOptionButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsThemeAuto}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Primary}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding SetThemeLightCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Sun}" Style="{StaticResource ButtonIconPath}"/>
                                <TextBlock Text="{Binding Source={x:Static loc:Loc.SettingsThemeLight}, Path=Value}"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ThemeOptionButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsThemeLight}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Primary}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding SetThemeDarkCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Moon}" Style="{StaticResource ButtonIconPath}"/>
                                <TextBlock Text="{Binding Source={x:Static loc:Loc.SettingsThemeDark}, Path=Value}"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ThemeOptionButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsThemeDark}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Primary}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <TextBlock Margin="0,12,0,0"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               FontSize="12"
                               Text="{Binding ThemeStatusText}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ContentCard}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding RegistryExpertMode, Mode=TwoWay}"
                              Margin="0,2,10,0"
                              VerticalAlignment="Top"/>

                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource Icon.ShieldAlert}" Style="{StaticResource HeaderIconPath}" Stroke="{DynamicResource Brush.Warning}"/>
                            <TextBlock Text="{Binding Source={x:Static loc:Loc.SettingsRegistryExpertMode}, Path=Value}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Source={x:Static loc:Loc.SettingsRegistryExpertHint}, Path=Value}"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
