<UserControl x:Class="WashinPC.Views.Pages.PrivacyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WashinPC.Localization">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ContentCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource Brush.Secondary30}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="12,12,0,0"
                        Padding="16,12">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Globe}" Style="{StaticResource HeaderIconPath}"/>
                        <TextBlock Text="{Binding Source={x:Static loc:Loc.PrivacySectionBrowserData}, Path=Value}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <ListView Grid.Row="1"
                          Margin="14,8,14,14"
                          ItemsSource="{Binding Items}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding SizeText, Mode=OneWay}"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           FontSize="13"
                                           FontFamily="Consolas"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Style="{StaticResource ContentCard}"
                Background="{DynamicResource Brush.BottomBarBg}"
                Padding="16,12">
            <StackPanel>
                <Border
                        Height="6"
                        CornerRadius="3"
                        Background="{DynamicResource Brush.Secondary}"
                        Margin="0,0,0,8"
                        ClipToBounds="True"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar Height="6"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource Brush.Primary}"
                                 Background="Transparent"
                                 BorderThickness="0"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Search}" Style="{StaticResource ButtonIconPath}"/>
                                <TextBlock Text="{Binding Source={x:Static loc:Loc.BtnScan}, Path=Value}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding CleanCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Sparkles}" Style="{StaticResource ButtonIconPath}"/>
                                <TextBlock Text="{Binding Source={x:Static loc:Loc.BtnClean}, Path=Value}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Column="3"
                               Text="{Binding SummaryText, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               FontSize="12"
                               FontFamily="Consolas"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
