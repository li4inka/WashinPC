<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark tokens mapped 1:1 from F:\wash/src/index.css (.dark) -->
    <Color x:Key="Color.WindowBg">#FF0F121A</Color>
    <Color x:Key="Color.PanelBg">#FF181C25</Color>
    <Color x:Key="Color.Border">#FF272B35</Color>
    <Color x:Key="Color.Input">#FF2B303B</Color>

    <Color x:Key="Color.Primary">#FF007BFF</Color>
    <Color x:Key="Color.PrimaryHover">#FF0272E9</Color>
    <Color x:Key="Color.PrimaryPressed">#FF0068D9</Color>

    <Color x:Key="Color.Secondary">#FF212630</Color>
    <Color x:Key="Color.SecondaryHover">#FF1F242E</Color>
    <Color x:Key="Color.SecondaryForeground">#FFC5CED7</Color>
    <Color x:Key="Color.Accent">#FF122D49</Color>
    <Color x:Key="Color.AccentForeground">#FF66B0FF</Color>

    <Color x:Key="Color.Text">#FFE0E6EB</Color>
    <Color x:Key="Color.TextMuted">#FF818A98</Color>

    <Color x:Key="Color.Success">#FF29A356</Color>
    <Color x:Key="Color.Warning">#FFEC9C13</Color>
    <Color x:Key="Color.Destructive">#FFD92626</Color>

    <Color x:Key="Color.CardHeaderBg">#FF1D212A</Color>
    <Color x:Key="Color.PanelBorder">#FF23262F</Color>
    <Color x:Key="Color.AppBackground">#FF0F121A</Color>

    <Color x:Key="Color.SidebarBg">#FF14171F</Color>
    <Color x:Key="Color.SidebarBorder">#FF23262F</Color>
    <Color x:Key="Color.SidebarText">#FF98A4B3</Color>
    <Color x:Key="Color.SidebarMuted">#FF67717E</Color>
    <Color x:Key="Color.SidebarAccent">#FF14283D</Color>
    <Color x:Key="Color.SidebarAccentForeground">#FF66B0FF</Color>

    <!-- Derived dark state layers from F:\wash utility classes (secondary/20, /30, /50, shadow-primary/20) -->
    <Color x:Key="Color.Secondary20">#33212630</Color>
    <Color x:Key="Color.Secondary30">#4D212630</Color>
    <Color x:Key="Color.Secondary50">#80212630</Color>
    <Color x:Key="Color.Border50">#80272B35</Color>
    <Color x:Key="Color.PrimaryShadow20">#33007BFF</Color>

    <SolidColorBrush x:Key="Brush.WindowBg" Color="{StaticResource Color.WindowBg}"/>
    <SolidColorBrush x:Key="Brush.PanelBg" Color="{StaticResource Color.PanelBg}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.Input" Color="{StaticResource Color.Input}"/>

    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}"/>
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.PrimaryHover}"/>
    <SolidColorBrush x:Key="Brush.PrimaryPressed" Color="{StaticResource Color.PrimaryPressed}"/>

    <SolidColorBrush x:Key="Brush.Secondary" Color="{StaticResource Color.Secondary}"/>
    <SolidColorBrush x:Key="Brush.SecondaryHover" Color="{StaticResource Color.SecondaryHover}"/>
    <SolidColorBrush x:Key="Brush.SecondaryForeground" Color="{StaticResource Color.SecondaryForeground}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentForeground" Color="{StaticResource Color.AccentForeground}"/>

    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}"/>

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.Destructive" Color="{StaticResource Color.Destructive}"/>

    <SolidColorBrush x:Key="Brush.CardHeaderBg" Color="{StaticResource Color.CardHeaderBg}"/>
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="{StaticResource Color.PanelBorder}"/>
    <SolidColorBrush x:Key="Brush.AppBackground" Color="{StaticResource Color.AppBackground}"/>
    <SolidColorBrush x:Key="Brush.SidebarBg" Color="{StaticResource Color.SidebarBg}"/>
    <SolidColorBrush x:Key="Brush.SidebarBorder" Color="{StaticResource Color.SidebarBorder}"/>
    <SolidColorBrush x:Key="Brush.SidebarText" Color="{StaticResource Color.SidebarText}"/>
    <SolidColorBrush x:Key="Brush.SidebarMuted" Color="{StaticResource Color.SidebarMuted}"/>
    <SolidColorBrush x:Key="Brush.SidebarAccent" Color="{StaticResource Color.SidebarAccent}"/>
    <SolidColorBrush x:Key="Brush.SidebarAccentForeground" Color="{StaticResource Color.SidebarAccentForeground}"/>
    <SolidColorBrush x:Key="Brush.BottomBarBg" Color="{StaticResource Color.PanelBg}"/>

    <SolidColorBrush x:Key="Brush.Secondary20" Color="{StaticResource Color.Secondary20}"/>
    <SolidColorBrush x:Key="Brush.Secondary30" Color="{StaticResource Color.Secondary30}"/>
    <SolidColorBrush x:Key="Brush.Secondary50" Color="{StaticResource Color.Secondary50}"/>
    <SolidColorBrush x:Key="Brush.Border50" Color="{StaticResource Color.Border50}"/>
    <SolidColorBrush x:Key="Brush.PrimaryShadow20" Color="{StaticResource Color.PrimaryShadow20}"/>

</ResourceDictionary>
