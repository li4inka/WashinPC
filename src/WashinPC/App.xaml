<Application x:Class="WashinPC.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>

            <!-- ================= CONVERTERS ================= -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

            <!-- ================= FALLBACK BRUSHES ================= -->
            <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#DDDDDD"/>

            <SolidColorBrush x:Key="Brush.TextMuted" Color="#777777"/>
            <SolidColorBrush x:Key="Brush.BottomBarBg" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="Brush.Border" Color="#DDDDDD"/>

            <!-- ================= THEMES ================= -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.Light.xaml"/>
                <ResourceDictionary Source="Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Application.Resources>
</Application>
