<UserControl x:Class="WashinPC.Views.Pages.ContextMenuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WashinPC.Localization">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ContentCard}">
            <DataGrid ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      FontFamily="{DynamicResource Font.App}"
                      FontSize="13"
                      MinRowHeight="36"
                      ColumnHeaderHeight="44"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      ColumnHeaderStyle="{StaticResource DataGridHeaderSecondary20}"
                      RowBackground="Transparent"
                      AlternatingRowBackground="Transparent"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      SnapsToDevicePixels="True">

                <DataGrid.Resources>
                    <Style x:Key="MenuCellText" TargetType="TextBlock">
                        <Setter Property="Margin" Value="12,8"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Style>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource FlatScrollBar}"/>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="58"
                                            HeaderStyle="{StaticResource DataGridHeaderCompactCentered}"
                                            CellStyle="{StaticResource DataGridCellCheckBoxCompact}"
                                            Header="{Binding Source={x:Static loc:Loc.ContextMenuColDisable}, Path=Value}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding Disable, Mode=TwoWay}"
                                          IsEnabled="{Binding IsToggleSupported}"
                                          ToolTip="{Binding ToggleDisabledReason}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="58"
                                            HeaderStyle="{StaticResource DataGridHeaderCompactCentered}"
                                            CellStyle="{StaticResource DataGridCellCheckBoxCompact}"
                                            Header="{Binding Source={x:Static loc:Loc.ContextMenuColDelete}, Path=Value}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource DestructiveCheckBox}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding Delete, Mode=TwoWay}"
                                          IsEnabled="{Binding IsDeleteSupported}"
                                          ToolTip="{Binding DeleteDisabledReason}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn ElementStyle="{StaticResource MenuCellText}" Width="2*"
                                        Header="{Binding Source={x:Static loc:Loc.ContextMenuColName}, Path=Value}"
                                        Binding="{Binding Name}"/>

                    <DataGridTextColumn ElementStyle="{StaticResource MenuCellText}" Width="*"
                                        Header="{Binding Source={x:Static loc:Loc.ContextMenuColTarget}, Path=Value}"
                                        Binding="{Binding Target}"/>

                    <DataGridTextColumn ElementStyle="{StaticResource MenuCellText}" Width="*"
                                        Header="{Binding Source={x:Static loc:Loc.ContextMenuColKind}, Path=Value}"
                                        Binding="{Binding Kind}"/>

                    <DataGridTextColumn ElementStyle="{StaticResource MenuCellText}" Width="*"
                                        Header="{Binding Source={x:Static loc:Loc.ContextMenuColScope}, Path=Value}"
                                        Binding="{Binding Scope}"/>

                    <DataGridTextColumn ElementStyle="{StaticResource MenuCellText}" Width="Auto"
                                        Header="{Binding Source={x:Static loc:Loc.ContextMenuColSource}, Path=Value}"
                                        Binding="{Binding Source}"/>

                    <DataGridTextColumn ElementStyle="{StaticResource MenuCellText}" Width="2*"
                                        Header="{Binding Source={x:Static loc:Loc.ContextMenuColRegistry}, Path=Value}"
                                        Binding="{Binding RegistryPath}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Style="{StaticResource ContentCard}"
                Background="{DynamicResource Brush.BottomBarBg}"
                Padding="16,12" MinHeight="76">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.RefreshCw}" Style="{StaticResource ButtonIconPath}"/>
                            <TextBlock Text="{Binding Source={x:Static loc:Loc.ContextMenuBtnRefresh}, Path=Value}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ApplyCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Check}" Style="{StaticResource ButtonIconPath}"/>
                            <TextBlock Text="{Binding Source={x:Static loc:Loc.ContextMenuBtnApply}, Path=Value}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding Summary}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           FontSize="12"
                           FontFamily="Consolas"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
