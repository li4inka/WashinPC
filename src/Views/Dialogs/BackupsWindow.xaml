<Window x:Class="WashinPC.Views.Dialogs.BackupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="1000" Height="680" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.WindowBg}"
        Foreground="{DynamicResource Brush.Text}">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
        <DataTemplate x:Key="DateHeader"><TextBlock Text="{Binding DataContext.DateLabel, RelativeSource={RelativeSource AncestorType=DataGrid}}"/></DataTemplate>
        <DataTemplate x:Key="TargetsHeader"><TextBlock Text="{Binding DataContext.TargetsLabel, RelativeSource={RelativeSource AncestorType=DataGrid}}"/></DataTemplate>
        <DataTemplate x:Key="ViewHeader"><TextBlock Text="{Binding DataContext.ViewLabel, RelativeSource={RelativeSource AncestorType=DataGrid}}"/></DataTemplate>
        <DataTemplate x:Key="CurrentHeader"><TextBlock Text="{Binding DataContext.CurrentLabel, RelativeSource={RelativeSource AncestorType=DataGrid}}"/></DataTemplate>
        <DataTemplate x:Key="SavedHeader"><TextBlock Text="{Binding DataContext.SavedLabel, RelativeSource={RelativeSource AncestorType=DataGrid}}"/></DataTemplate>
        <DataTemplate x:Key="StatusHeader"><TextBlock Text="{Binding DataContext.StatusLabel, RelativeSource={RelativeSource AncestorType=DataGrid}}"/></DataTemplate>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Help}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                  IsEnabled="{Binding Ui.IsIdle}" HeadersVisibility="Column" Background="{DynamicResource Brush.PanelBg}">
            <DataGrid.Columns>
                <DataGridTextColumn HeaderTemplate="{StaticResource DateHeader}" Binding="{Binding Date, StringFormat=g}" Width="145"/>
                <DataGridTextColumn HeaderTemplate="{StaticResource TargetsHeader}" Binding="{Binding Targets}" Width="*"/>
                <DataGridTextColumn HeaderTemplate="{StaticResource ViewHeader}" Binding="{Binding ViewLabel}" Width="180"/>
                <DataGridTextColumn HeaderTemplate="{StaticResource StatusHeader}" Binding="{Binding Error}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Margin="0,12" IsEnabled="{Binding Ui.IsIdle}">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding NeedsView}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style></StackPanel.Style>
                <TextBlock Text="{Binding ViewLabel}" Margin="0,0,12,8"/>
                <RadioButton Content="x86" IsChecked="{Binding View32}" GroupName="View" Margin="0,0,12,8"/>
                <RadioButton Content="x64" IsChecked="{Binding View64}" GroupName="View" Margin="0,0,12,8"/>
            </StackPanel>
            <WrapPanel>
                <Button Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
                <Button Content="{Binding FolderLabel}" Command="{Binding FolderCommand}" Style="{StaticResource SecondaryButton}"/>
                <Button Content="{Binding CompareLabel}" Command="{Binding CompareCommand}" Style="{StaticResource SecondaryButton}"/>
                <Button Content="{Binding RestoreLabel}" Command="{Binding RestoreCommand}" Style="{StaticResource PrimaryButton}"/>
            </WrapPanel>
        </StackPanel>
        <DataGrid Grid.Row="3" ItemsSource="{Binding Differences}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" Background="{DynamicResource Brush.PanelBg}">
            <DataGrid.Columns>
                <DataGridTextColumn HeaderTemplate="{StaticResource TargetsHeader}" Binding="{Binding Object}" Width="2*"/>
                <DataGridTextColumn HeaderTemplate="{StaticResource CurrentHeader}" Binding="{Binding Before}" Width="*"/>
                <DataGridTextColumn HeaderTemplate="{StaticResource SavedHeader}" Binding="{Binding After}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="{Binding Ui.CancelLabel}" Command="{Binding Ui.CancelCommand}" Style="{StaticResource SecondaryButton}"
                    Visibility="{Binding Ui.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
