<Window x:Class="WashinPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WashinPC.Localization"
        Title="{Binding AppInfo.Version, StringFormat=WashinPC {0}}"
        Icon="/WashinPC;component/Assets/WashinPC.ico"
        Width="1280"
        Height="720"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.AppBackground}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource Brush.AppBackground}">
        <Border Margin="8" Style="{StaticResource AppContainer}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Background="{DynamicResource Brush.SidebarBg}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="18,18,18,14" BorderBrush="{DynamicResource Brush.SidebarBorder}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Width="32" Height="32" Source="/WashinPC;component/Assets/WashinPC.png" RenderOptions.BitmapScalingMode="HighQuality"/>

                            <TextBlock Text="{Binding AppInfo.ProductName}" Margin="10,0,0,0" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}"/>

                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource ChannelBadge}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AppInfo.Channel}" Value="RELEASE">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AppInfo.Channel}" Value="DEBUG">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Warning}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AppInfo.Channel}" Value="BETA">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Primary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Style="{StaticResource ChannelBadgeText}" Text="{Binding AppInfo.Channel}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="Sidebar"
                             Grid.Row="1"
                             Style="{StaticResource SidebarList}"
                             ItemContainerStyle="{StaticResource SidebarItem}"
                             SelectionChanged="Sidebar_SelectionChanged">

                        <ListBoxItem Tag="Cleaner">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.Trash2}" Style="{StaticResource SidebarIconPath}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Source={x:Static loc:Loc.TabCleaner}, Path=Value}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="Privacy">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.Shield}" Style="{StaticResource SidebarIconPath}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Source={x:Static loc:Loc.TabPrivacy}, Path=Value}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="Registry">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.Database}" Style="{StaticResource SidebarIconPath}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Source={x:Static loc:Loc.TabRegistry}, Path=Value}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="ContextMenu">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.Menu}" Style="{StaticResource SidebarIconPath}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Source={x:Static loc:Loc.TabContextMenu}, Path=Value}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="Settings">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.Settings}" Style="{StaticResource SidebarIconPath}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Source={x:Static loc:Loc.TabSettings}, Path=Value}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <Border Grid.Row="2" Padding="16,12" BorderBrush="{DynamicResource Brush.SidebarBorder}" BorderThickness="0,1,0,0">
                        <StackPanel Opacity="0.88">
                            <TextBlock Text="{Binding AppInfo.Version}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
                            <TextBlock Text="{Binding AppInfo.Build}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
                            <TextBlock Text="{Binding AppInfo.Company}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Column="1" Style="{StaticResource ThinSeparator}"/>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ScrollViewer x:Name="PageViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ContentControl x:Name="ContentHost" MinWidth="760" MinHeight="480" IsEnabled="{Binding Ui.IsIdle}"/>
                    </ScrollViewer>
                    <DockPanel Grid.Row="1" Margin="24,0,24,12" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{Binding BackupsLabel}" Command="{Binding BackupsCommand}" Style="{StaticResource SecondaryButton}"/>
                            <Button Content="{Binding DetailsLabel}" Command="{Binding DetailsCommand}" Style="{StaticResource SecondaryButton}"/>
                            <Button Content="{Binding Ui.CancelLabel}" Command="{Binding Ui.CancelCommand}" Style="{StaticResource SecondaryButton}" Visibility="{Binding Ui.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Ui.StatusText}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
