<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- COLORS -->
    <Color x:Key="Bg">#1C1F23</Color>
    <Color x:Key="Panel">#24282E</Color>
    <Color x:Key="Border">#2E333A</Color>
    <Color x:Key="Text">#E6EAF0</Color>
    <Color x:Key="Accent">#4C8DFF</Color>

    <!-- BRUSHES -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource Bg}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Panel}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>

</ResourceDictionary>
