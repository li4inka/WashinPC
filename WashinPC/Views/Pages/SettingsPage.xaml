<UserControl x:Class="WashinPC.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="300">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Grid.Row="0"
                   Text="Настройки"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <!-- CONTENT -->
        <StackPanel Grid.Row="1">

            <CheckBox x:Name="ChkDarkMode"
                      Content="Тёмная тема"
                      FontSize="14"
                      Margin="0,0,0,10"
                      Checked="DarkModeChanged"
                      Unchecked="DarkModeChanged"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Язык интерфейса:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbLanguage"
                          Width="180"
                          SelectionChanged="LanguageChanged">
                    <ComboBoxItem Content="Русский"/>
                    <ComboBoxItem Content="English"/>
                </ComboBox>
            </StackPanel>

        </StackPanel>

        <!-- FOOTER -->
        <TextBlock Grid.Row="2"
                   Opacity="0.6"
                   TextWrapping="Wrap"
                   VerticalAlignment="Bottom"
                   Text="Изменения применяются после перезапуска приложения."/>
    </Grid>
</UserControl>
