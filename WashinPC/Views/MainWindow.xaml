<Window x:Class="WashinPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:WashinPC.Views.Pages"
        Title="WashinPC"
        Width="1100"
        Height="700"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <!-- SIDEBAR -->
        <Border Grid.Column="0"
        Background="{StaticResource PanelBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="0,0,1,0">

            <ListBox x:Name="Sidebar"
         SelectionChanged="Sidebar_SelectionChanged"
         Background="Transparent"
         BorderThickness="0"
         ItemContainerStyle="{StaticResource SidebarButtonStyle}">

                <ListBoxItem Tag="Cleaner">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Очистка" FontSize="14"/>
                    </StackPanel>
                </ListBoxItem>

                <ListBoxItem Tag="Privacy">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Приватность" FontSize="14"/>
                    </StackPanel>
                </ListBoxItem>

                <ListBoxItem Tag="Registry">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Реестр" FontSize="14"/>
                    </StackPanel>
                </ListBoxItem>

                <ListBoxItem Tag="Settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Настройки" FontSize="14"/>
                    </StackPanel>
                </ListBoxItem>

            </ListBox>
        </Border>


        <!-- CONTENT -->
        <Border Grid.Column="1"
                Padding="16"
                Background="#F5F5F5">

            <ContentControl x:Name="ContentHost"/>
        </Border>
    </Grid>
</Window>
