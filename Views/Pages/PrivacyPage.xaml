<UserControl x:Class="WashinPC.Views.Pages.PrivacyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WashinPC.Localization">

    <Grid Margin="14">
        <Border Style="{StaticResource ContentCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LIST -->
                <ListView Grid.Row="0"
                          ItemsSource="{Binding Items}"
                          BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsChecked}"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
           VerticalAlignment="Center">
    <Run Text="{Binding Name}" />
    <Run Text=" " />
    <Run Text="{Binding SizeText, Mode=OneWay}"
         Foreground="{StaticResource Brush.TextMuted}" />
                                </TextBlock>

                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- BOTTOM BAR -->
                <Border Grid.Row="1"
                        Background="{StaticResource Brush.BottomBarBg}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,1,0,0"
                        Padding="10,8">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="{Binding Source={x:Static loc:Loc.BtnScan}, Path=Value}"
                                    Command="{Binding ScanCommand}"/>

                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="{Binding Source={x:Static loc:Loc.BtnClean}, Path=Value}"
                                    Command="{Binding CleanCommand}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding SummaryText}"
                                   Foreground="{StaticResource Brush.TextMuted}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
