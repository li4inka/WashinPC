<UserControl x:Class="WashinPC.Views.Pages.RegistryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WashinPC.Localization">

    <UserControl.Resources>
        <CollectionViewSource x:Key="CategoriesView"
                              Source="{Binding Categories}">
            <CollectionViewSource.GroupDescriptions>
                <!-- ?? group by loc -->
                <PropertyGroupDescription PropertyName="RiskTitle"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT -->
        <Border Grid.Column="0" Style="{StaticResource ContentCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar"
                           BasedOn="{StaticResource FlatScrollBar}"/>
                </ScrollViewer.Resources>

                <ItemsControl ItemsSource="{Binding Source={StaticResource CategoriesView}}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="12,12,12,6"
                                               FontWeight="SemiBold"
                                               Foreground="#666"
                                               Text="{Binding Name}"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="12,4">
                                <CheckBox Content="{Binding Title}"
                                          IsChecked="{Binding IsChecked}"/>

                                <!-- ? Dangerous -->
                                <Button Content="?"
        Command="{Binding InfoCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button"
               BasedOn="{StaticResource InfoIconButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDangerous}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- RIGHT -->
        <Border Grid.Column="2" Style="{StaticResource ContentCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Items}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          GridLinesVisibility="None"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFAFA"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow">

                    <DataGrid.Resources>
                        <Style TargetType="ScrollBar"
                               BasedOn="{StaticResource FlatScrollBar}"/>
                    </DataGrid.Resources>

                    <DataGrid.Columns>

                        <DataGridCheckBoxColumn Width="40"
                                                Binding="{Binding IsSelected}"/>

                        <DataGridTextColumn
                            Header="{Binding Source={x:Static loc:Loc.ColCategory}, Path=Value}"
                            Binding="{Binding Category}"
                            Width="*"/>

                        <DataGridTextColumn
                            Header="{Binding Source={x:Static loc:Loc.ColKey}, Path=Value}"
                            Binding="{Binding KeyPath}"
                            Width="2*"/>

                        <DataGridTextColumn
                            Header="{Binding Source={x:Static loc:Loc.ColDetails}, Path=Value}"
                            Binding="{Binding Details}"
                            Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- BOTTOM -->
                <Border Grid.Row="1"
                        Margin="12,10,12,12"
                        Padding="12"
                        Background="#FAFAFA"
                        CornerRadius="10">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="{Binding Source={x:Static loc:Loc.BtnScan}, Path=Value}"
                                    Command="{Binding ScanCommand}"/>

                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="{Binding Source={x:Static loc:Loc.BtnFix}, Path=Value}"
                                    Command="{Binding FixCommand}"/>
                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  Content="{Binding Source={x:Static loc:Loc.ChkBackup}, Path=Value}"
                                  IsChecked="{Binding CreateBackup}"
                                  Margin="20,0,0,0"/>

                        <TextBlock Grid.Column="3"
                                   Text="{Binding SummaryText}"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
