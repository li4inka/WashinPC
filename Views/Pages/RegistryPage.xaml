<UserControl x:Class="WashinPC.Views.Pages.RegistryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WashinPC.Localization">

    <Grid Margin="14">
        <!-- ONE CARD FOR GRID + BOTTOM BAR -->
        <Border Style="{StaticResource ContentCard}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TABLE -->
                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Items}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal">

                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Width="40"
                                                Binding="{Binding IsSelected}"/>

                        <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.ColCategory}, Path=Value}"
                                            Binding="{Binding Category}"
                                            Width="*"/>

                        <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.ColKey}, Path=Value}"
                                            Binding="{Binding KeyPath}"
                                            Width="2*"/>

                        <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.ColDetails}, Path=Value}"
                                            Binding="{Binding Details}"
                                            Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- BOTTOM BAR -->
                <Border Grid.Row="1"
                        Background="{StaticResource Brush.BottomBarBg}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,1,0,0"
                        Padding="10,8">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- BUTTONS -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="{Binding Source={x:Static loc:Loc.BtnScan}, Path=Value}"
                                    Command="{Binding ScanCommand}"/>

                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="{Binding Source={x:Static loc:Loc.BtnFix}, Path=Value}"
                                    Command="{Binding FixCommand}"/>
                        </StackPanel>

                        <!-- OPTION -->
                        <CheckBox Grid.Column="1"
                                  Content="{Binding Source={x:Static loc:Loc.ChkBackup}, Path=Value}"
                                  IsChecked="{Binding CreateBackup}"
                                  Margin="20,0,0,0"
                                  VerticalAlignment="Center"/>

                        <!-- SUMMARY -->
                        <TextBlock Grid.Column="3"
                                   Text="{Binding SummaryText}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.TextMuted}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
