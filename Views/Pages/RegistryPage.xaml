<UserControl x:Class="WashinPC.Views.Pages.RegistryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WashinPC.Localization"
             MinHeight="400">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Source={x:Static loc:Loc.TabRegistry}, Path=Value}"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <!-- ACTIONS -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">

            <Button Width="140"
                    Margin="0,0,8,0"
                    Content="{Binding Source={x:Static loc:Loc.BtnScan}, Path=Value}"
                    Command="{Binding ScanCommand}"/>

            <Button Width="140"
                    Content="{Binding Source={x:Static loc:Loc.BtnFix}, Path=Value}"
                    Command="{Binding FixCommand}"/>

            <CheckBox Content="{Binding Source={x:Static loc:Loc.ChkBackup}, Path=Value}"/>
        </StackPanel>

        <!-- LIST -->
        <ListView Grid.Row="2"
                  ItemsSource="{Binding Items}"
                  FontSize="13"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource BorderBrush}">

            <ListView.View>
                <GridView>

                    <GridViewColumn Header="✓" Width="40">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}"
                                          HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                        <GridViewColumn Width="180">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Source={x:Static loc:Loc.ColCategory}, Path=Value}"/>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>

                            <GridViewColumn.DisplayMemberBinding>
                                <Binding Path="Category"/>
                            </GridViewColumn.DisplayMemberBinding>
                        </GridViewColumn>

                        <GridViewColumn Width="320">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Source={x:Static loc:Loc.ColKey}, Path=Value}"/>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>

                            <GridViewColumn.DisplayMemberBinding>
                                <Binding Path="KeyPath"/>
                            </GridViewColumn.DisplayMemberBinding>
                        </GridViewColumn>

                        <GridViewColumn Width="260">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Source={x:Static loc:Loc.ColDetails}, Path=Value}"/>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>

                            <GridViewColumn.DisplayMemberBinding>
                                <Binding Path="Details"/>
                            </GridViewColumn.DisplayMemberBinding>
                        </GridViewColumn>


                </GridView>
            </ListView.View>
        </ListView>

        <!-- SUMMARY -->
        <TextBlock Grid.Row="3"
                   Margin="0,10,0,0"
                   FontWeight="SemiBold"
                   Text="{Binding SummaryText}"/>
    </Grid>
</UserControl>
