<UserControl
    x:Class="WashinPC.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:WashinPC.Localization">

    <StackPanel Margin="24" Width="320">

        <TextBlock
            Text="{Binding Source={x:Static loc:Loc.SettingsLanguage}, Path=Value}"
            Margin="0,0,0,8"
            FontWeight="SemiBold"/>

        <ComboBox
            SelectedIndex="{Binding LanguageIndex}"
            Margin="0,0,0,16">
            <ComboBoxItem Content="Русский"/>
            <ComboBoxItem Content="English"/>
        </ComboBox>

        <TextBlock
            Text="{Binding Source={x:Static loc:Loc.SettingsInstantApply}, Path=Value}"
            Foreground="Gray"/>
    </StackPanel>
</UserControl>
