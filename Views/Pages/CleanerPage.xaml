<UserControl x:Class="WashinPC.Views.Pages.CleanerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WashinPC.Localization">

    <Grid Margin="14">
        <Border Style="{StaticResource ContentCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LIST -->
                <ListView Grid.Row="0"
                          ItemsSource="{Binding Items}"
                          BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center">
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding SizeText, Mode=OneWay}"
                                         Foreground="{StaticResource Brush.TextMuted}" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- BOTTOM BAR -->
                <Border Grid.Row="1"
        Margin="12,10,12,12"
        Padding="12"
        Background="#FAFAFA"
        CornerRadius="10"
        SnapsToDevicePixels="True">

                    <Border.Effect>
                        <DropShadowEffect
            BlurRadius="16"
            ShadowDepth="0"
            Opacity="0.18"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Height="6"
                                CornerRadius="3"
                                Background="#FFE5E7EB"
                                ClipToBounds="True"
                                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ProgressBar Height="6"
                                         IsIndeterminate="True"
                                         Foreground="{StaticResource Brush.Primary}"
                                         Background="Transparent"
                                         BorderThickness="0"/>
                        </Border>

                        <Grid Grid.Row="1"
                              Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- BUTTONS -->
                        <StackPanel Grid.Column="0"
                    Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}"
                    Content="{Binding Source={x:Static loc:Loc.BtnScan}, Path=Value}"
                    Command="{Binding ScanCommand}"/>

                            <Button Style="{StaticResource PrimaryButton}"
                    Content="{Binding Source={x:Static loc:Loc.BtnClean}, Path=Value}"
                    Command="{Binding CleanCommand}"/>

                            <Button Style="{StaticResource PrimaryButton}"
                    Content="{Binding Source={x:Static loc:Loc.BtnRecycle}, Path=Value}"
                    Command="{Binding RecycleCommand}"/>
                        </StackPanel>

                        <!-- OPTION -->
                        <CheckBox Grid.Column="4"
                  Content="{Binding Source={x:Static loc:Loc.ChkAggressive}, Path=Value}"
                  IsChecked="{Binding IsAggressive, Mode=TwoWay}"
                  VerticalAlignment="Center"/>

                        <!-- SUMMARY -->
                        <TextBlock Grid.Column="6"
                   Text="{Binding SummaryText, Mode=OneWay}"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource Brush.TextMuted}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
