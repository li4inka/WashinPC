<UserControl x:Class="WashinPC.Views.Pages.CleanerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WashinPC.Controls"
             xmlns:loc="clr-namespace:WashinPC.Localization"
             MinHeight="400">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Source={x:Static loc:Loc.TabCleaner}, Path=Value}"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <!-- ACTIONS -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">

            <Button Width="140"
                    Margin="0,0,8,0"
                    Content="{Binding Source={x:Static loc:Loc.BtnScan}, Path=Value}"
                    Command="{Binding ScanCommand}"/>

            <Button Width="140"
                    Margin="0,0,8,0"
                    Content="{Binding Source={x:Static loc:Loc.BtnClean}, Path=Value}"
                    Command="{Binding CleanCommand}"/>

            <Button Width="180"
                    Content="{Binding Source={x:Static loc:Loc.BtnRecycle}, Path=Value}"
                    Command="{Binding RecycleCommand}"/>

            <CheckBox Margin="20,0,0,0"
                      VerticalAlignment="Center"
                      Content="{Binding Source={x:Static loc:Loc.ChkAggressive}, Path=Value}"
                      IsChecked="{Binding IsAggressive}"/>
        </StackPanel>

        <!-- CARDS -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:CleanerCardControl/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- SUMMARY -->
        <TextBlock Grid.Row="3"
                   Margin="0,10,0,0"
                   FontWeight="SemiBold"
                   Text="{Binding SummaryText}"/>
    </Grid>
</UserControl>
