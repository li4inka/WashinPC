<Window x:Class="WashinPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WashinPC.Localization"
        Title="{Binding AppInfo.Version, StringFormat=WashinPC {0}}"
        Width="1200"
        Height="640"
        MinWidth="1200"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.AppBackground}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- WINDOW CONTENT -->
    <Grid Background="{StaticResource Brush.AppBackground}">

        <!-- APP CARD (RemoteHelper) -->
        <Border
            Margin="20"
            Background="White"
            CornerRadius="14"
            SnapsToDevicePixels="True">

            <!-- SHADOW -->
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="28"
                    ShadowDepth="0"
                    Opacity="0.22"/>
            </Border.Effect>

            <!-- CLIPPED CONTENT -->
            <Border CornerRadius="14"
                    ClipToBounds="True"
                    Background="White">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ================= HEADER ================= -->
                    <DockPanel Margin="14,10">

                        <!-- BRAND -->
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Left">

                            <TextBlock Text="{Binding AppInfo.ProductName}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <Border Style="{StaticResource ChannelBadge}"
                                    Margin="8,0,0,0">
                                <TextBlock Text="{Binding AppInfo.Channel}"
                                           Style="{StaticResource ChannelBadgeText}"/>
                            </Border>
                        </StackPanel>

                    </DockPanel>

                    <!-- HEADER SEPARATOR -->
                    <Border Grid.Row="1"
                            Background="{StaticResource Brush.Border}"/>

                    <!-- ================= BODY ================= -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- SIDEBAR -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- NAV -->
                            <ListBox x:Name="Sidebar"
         Grid.Row="0"
         Style="{StaticResource SidebarList}"
         ItemContainerStyle="{StaticResource SidebarItem}"
         SelectionChanged="Sidebar_SelectionChanged">

                                <ListBoxItem Tag="Cleaner"
                 Content="{Binding Source={x:Static loc:Loc.TabCleaner}, Path=Value}"/>

                                <ListBoxItem Tag="Privacy"
                 Content="{Binding Source={x:Static loc:Loc.TabPrivacy}, Path=Value}"/>

                                <ListBoxItem Tag="Registry"
                 Content="{Binding Source={x:Static loc:Loc.TabRegistry}, Path=Value}"/>

                                <!-- NEW TOOL -->
                                <ListBoxItem Tag="ContextMenu"
                 Content="{Binding Source={x:Static loc:Loc.TabContextMenu}, Path=Value}"/>

                                <ListBoxItem Tag="Settings"
                                            Content="{Binding Source={x:Static loc:Loc.TabSettings}, Path=Value}"/>

                            </ListBox>
                            <!-- SIDEBAR INFO -->
                            <StackPanel Grid.Row="1"
                                        Margin="14,10"
                                        VerticalAlignment="Bottom"
                                        Opacity="0.75">

                                <TextBlock Text="{Binding AppInfo.Version}"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.TextMuted}"/>

                                <TextBlock Text="{Binding AppInfo.Build}"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.TextMuted}"/>

                                <TextBlock Text="{Binding AppInfo.Company}"
                                           Margin="0,6,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.TextMuted}"/>
                            </StackPanel>
                        </Grid>

                        <!-- SIDEBAR SEPARATOR -->
                        <Border Grid.Column="1"
                                Background="{StaticResource Brush.Border}"/>

                        <!-- CONTENT -->
                        <ContentControl x:Name="ContentHost"
                                        Grid.Column="2"
                                        Margin="12"/>
                    </Grid>
                </Grid>
            </Border>

        </Border>
    </Grid>
</Window>