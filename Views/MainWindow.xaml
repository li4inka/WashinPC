<Window x:Class="WashinPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:WashinPC.Services"
        xmlns:loc="clr-namespace:WashinPC.Localization"
        Title="{Binding Source={x:Static loc:Loc.AppTitle}, Path=Value}"
        Width="1100"
        Height="700"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- MENU -->
                <ListBox x:Name="Sidebar"
                         Grid.Row="0"
                         SelectionChanged="Sidebar_SelectionChanged"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource SidebarButtonStyle}">

                    <ListBoxItem Tag="Cleaner">
                        <TextBlock FontSize="14"
                                   Text="{Binding Source={x:Static loc:Loc.TabCleaner}, Path=Value}"/>
                    </ListBoxItem>

                    <ListBoxItem Tag="Privacy">
                        <TextBlock FontSize="14"
                                   Text="{Binding Source={x:Static loc:Loc.TabPrivacy}, Path=Value}"/>
                    </ListBoxItem>

                    <ListBoxItem Tag="Registry">
                        <TextBlock FontSize="14"
                                   Text="{Binding Source={x:Static loc:Loc.TabRegistry}, Path=Value}"/>
                    </ListBoxItem>

                    <ListBoxItem Tag="Settings">
                        <TextBlock FontSize="14"
                                   Text="{Binding Source={x:Static loc:Loc.TabSettings}, Path=Value}"/>
                    </ListBoxItem>

                </ListBox>

                <!-- FOOTER -->
                <Border Grid.Row="1"
                        Padding="12"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource BorderBrush}">

                    <StackPanel>

                        <!-- APP NAME + BETA -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="WashinPC"
                                       FontWeight="SemiBold"
                                       FontSize="14"/>

                            <Border Background="#589fe1"
                                    CornerRadius="4"
                                    Margin="8,0,0,0"
                                    Padding="6,1">
                                <TextBlock Text="BETA"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>
                            </Border>
                        </StackPanel>

                        <!-- VERSION -->
                        <TextBlock Margin="0,6,0,0"
           FontSize="11"
           Opacity="0.8">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}{1}">
                                    <Binding Source="{x:Static loc:Loc.VersionLabel}" Path="Value"/>
                                    <Binding Path="Version"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>



                        <!-- BUILD -->
                        <TextBlock FontSize="11"
                                   Opacity="0.8">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}{1}">
                                        <Binding Source="{x:Static loc:Loc.BuildLabel}" Path="Value"/>
                                        <Binding Path="Build"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                        </TextBlock>


                        <!-- COPYRIGHT -->
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="11"
                                   Opacity="0.6"
                                   Text="{Binding Source={x:Static loc:Loc.Copyright}, Path=Value}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Border Grid.Column="1"
                Padding="16"
                Background="{DynamicResource WindowBrush}">

            <DockPanel LastChildFill="True">

                <!-- STATUS BAR -->
                <Border DockPanel.Dock="Bottom"
                        Margin="0,12,0,0"
                        Padding="10,6"
                        CornerRadius="6"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">

                    <TextBlock FontSize="12"
                               Opacity="0.85"
                               Text="{Binding Source={x:Static services:AppUiState.Instance},
                                              Path=StatusText}"/>
                </Border>

                <!-- CONTENT + OVERLAY -->
                <Grid>
                    <ContentControl x:Name="ContentHost"/>

                    <Border Background="#AA000000"
                            CornerRadius="8"
                            Visibility="{Binding Source={x:Static services:AppUiState.Instance},
                                                 Path=IsBusy,
                                                 Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <ProgressBar Width="220"
                                         Height="6"
                                         IsIndeterminate="True"/>
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="White"
                                       FontSize="13"
                                       Text="{Binding Source={x:Static services:AppUiState.Instance},
                                                      Path=BusyText}"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </DockPanel>
        </Border>
    </Grid>
</Window>
